{
  "name": "snakkaz-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173 --open",
    "dev:network": "vite --host",
    "dev:mcp": "node snakkaz-mcp-server.js",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:analyze": "vite build --mode production --outDir dist-analyze --sourcemap",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:integration": "jest --config jest.integration.config.js",
    "test:unit": "jest --testPathIgnore='integration/'",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:beta": "jest --testPathPattern='encryption|chatService' --passWithNoTests && echo '✅ Core unit tests passed - Beta ready for manual testing!'",
    "prepare-deploy": "npm run build:prod && node scripts/prepare-deploy.js",
    "build:csp": "npm run build:prod && ./src/services/encryption/inject-csp.sh",
    "build:nocf": "npm run build:prod && ./src/services/encryption/inject-csp.sh",
    "clean": "rimraf dist",
    "db:fix": "./run-db-fix.sh",
    "db:backup": "npx supabase db dump -f supabase/backups/backup-$(date +%Y%m%d%H%M%S).sql",
    "supabase:setup-local": "./setup-local-supabase.sh",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "supabase:link": "npx supabase link --project-ref wqpoozpbceucynsojmbk",
    "supabase:pull": "npx supabase db pull",
    "supabase:push": "npx supabase db push",
    "supabase:reset": "npx supabase db reset",
    "dev:with-supabase": "npm run supabase:start && npm run dev",
    "deploy": "./deploy.sh",
    "deploy:build": "npm run build && echo Build completed successfully",
    "deploy:clean": "rm -rf dist && npm run build",
    "deploy:quick": "lftp -f quick-deploy.lftp",
    "health-check": "./health-check.sh",
    "clean-deploy": "rm -rf dist && npm run build && ./deploy.sh",
    "fase4:test:e2e": "playwright test",
    "fase4:test:e2e:ui": "playwright test --ui",
    "fase4:test:load": "artillery run tests/load/artillery-config.yml",
    "fase4:test:performance": "playwright test tests/e2e/performance.test.ts",
    "fase4:test:all": "npm run test:ci && npm run fase4:test:e2e && npm run fase4:test:performance",
    "fase4:deploy:production": "tsx scripts/production-deployment.ts production",
    "fase4:deploy:staging": "tsx scripts/production-deployment.ts staging",
    "fase4:build:optimized": "VITE_APP_ENV=production npm run build:prod",
    "fase4:analyze:bundle": "npm run build:analyze && npx vite-bundle-analyzer dist-analyze",
    "fase4:test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit"
  },
