#!/bin/bash

# 🎯 SNAKKAZ PROJECT HEALTH DASHBOARD
# Comprehensive system monitoring and status reporting

echo "🚀 SNAKKAZ PROJECT HEALTH DASHBOARD"
echo "===================================="
echo ""
echo "🕐 Generated: $(date)"
echo "🏠 Directory: $(pwd)"
echo ""

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Live Site Health
echo -e "${BLUE}🌐 LIVE SITE STATUS${NC}"
echo "==================="
HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" https://www.snakkaz.com 2>/dev/null || echo "FAIL")
if [ "$HTTP_STATUS" = "200" ]; then
    echo -e "✅ ${GREEN}www.snakkaz.com - ONLINE (HTTP 200)${NC}"
    
    # Check current bundle
    CURRENT_BUNDLE=$(curl -s https://www.snakkaz.com 2>/dev/null | grep -o 'index-[^.]*\.js' | head -1)
    if [ -n "$CURRENT_BUNDLE" ]; then
        echo "📦 Current bundle: $CURRENT_BUNDLE"
    fi
    
    # Check for Norwegian content
    if curl -s https://www.snakkaz.com | grep -q "SnakkaZ"; then
        echo "🇳🇴 Norwegian branding: Present"
    fi
    
    # Get response time
    RESPONSE_TIME=$(curl -w "%{time_total}" -s -o /dev/null https://www.snakkaz.com 2>/dev/null || echo "N/A")
    echo "⚡ Response time: ${RESPONSE_TIME}s"
    
else
    echo -e "❌ ${RED}www.snakkaz.com - OFFLINE or ERROR (HTTP $HTTP_STATUS)${NC}"
    echo "🔧 Recommended action: Run emergency deployment"
fi
echo ""

# Git Repository Health
echo -e "${BLUE}📝 GIT REPOSITORY STATUS${NC}"
echo "========================"
CURRENT_BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
echo "🌿 Current branch: $CURRENT_BRANCH"

# Check if there are uncommitted changes
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    echo -e "⚠️ ${YELLOW}Uncommitted changes detected${NC}"
    git status --short
    echo "🔧 Recommended: Run './snakkaz sync' to commit changes"
else
    echo -e "✅ ${GREEN}Working directory clean${NC}"
fi

# Check remote status
REMOTE_URL=$(git config --get remote.origin.url 2>/dev/null || echo "No remote")
echo "🔗 Remote: $REMOTE_URL"

# Check last commit
LAST_COMMIT=$(git log -1 --format="%h - %s (%cr)" 2>/dev/null || echo "No commits")
echo "📝 Last commit: $LAST_COMMIT"
echo ""

# Build Status
echo -e "${BLUE}🏗️  BUILD STATUS${NC}"
echo "================"

if [ -d "dist" ]; then
    BUILD_FILES=$(find dist -name "*.js" | wc -l)
    echo -e "✅ ${GREEN}Build directory exists${NC}"
    echo "📊 JavaScript bundles: $BUILD_FILES"
    
    if [ "$BUILD_FILES" -gt 50 ]; then
        echo -e "⚠️ ${YELLOW}High bundle count - optimization recommended${NC}"
        echo "🔧 Goal: Reduce to ~20 optimized bundles"
    fi
    
    # Check build size
    if command -v du >/dev/null 2>&1; then
        BUILD_SIZE=$(du -sh dist 2>/dev/null | cut -f1)
        echo "💾 Build size: $BUILD_SIZE"
    fi
else
    echo -e "❌ ${RED}Build directory missing${NC}"
    echo "🔧 Run: npm run build"
fi
echo ""

# Dependencies Health
echo -e "${BLUE}📦 DEPENDENCIES STATUS${NC}"
echo "======================"

if [ -f "package.json" ]; then
    echo -e "✅ ${GREEN}package.json present${NC}"
    
    if [ -d "node_modules" ]; then
        echo -e "✅ ${GREEN}node_modules installed${NC}"
        
        # Check for security vulnerabilities
        if command -v npm >/dev/null 2>&1; then
            AUDIT_OUTPUT=$(npm audit --json 2>/dev/null)
            if [ $? -eq 0 ]; then
                VULNERABILITIES=$(echo "$AUDIT_OUTPUT" | grep -o '"vulnerabilities":[0-9]*' | cut -d':' -f2 || echo "0")
                if [ "$VULNERABILITIES" -gt 0 ]; then
                    echo -e "⚠️ ${YELLOW}Security vulnerabilities: $VULNERABILITIES${NC}"
                    echo "🔧 Run: npm audit fix"
                else
                    echo -e "✅ ${GREEN}No security vulnerabilities${NC}"
                fi
            fi
        fi
    else
        echo -e "❌ ${RED}node_modules missing${NC}"
        echo "🔧 Run: npm install"
    fi
else
    echo -e "❌ ${RED}package.json missing${NC}"
fi
echo ""

# Testing Status
echo -e "${BLUE}🧪 TESTING STATUS${NC}"
echo "=================="

# Check for test files
TEST_FILES=$(find . -name "*.test.*" -o -name "*.spec.*" | grep -v node_modules | wc -l)
if [ "$TEST_FILES" -gt 0 ]; then
    echo -e "✅ ${GREEN}Test files found: $TEST_FILES${NC}"
else
    echo -e "❌ ${RED}No test files found${NC}"
    echo "🔧 Implement test suite for better code quality"
fi

# Check for testing frameworks
if [ -f "package.json" ]; then
    if grep -q "jest\|vitest\|mocha\|cypress" package.json; then
        echo -e "✅ ${GREEN}Testing framework configured${NC}"
    else
        echo -e "⚠️ ${YELLOW}No testing framework detected${NC}"
    fi
fi
echo ""

# GitHub Actions Status
echo -e "${BLUE}🔄 GITHUB ACTIONS STATUS${NC}"
echo "========================"

if [ -d ".github/workflows" ]; then
    WORKFLOW_COUNT=$(find .github/workflows -name "*.yml" -o -name "*.yaml" | wc -l)
    echo -e "✅ ${GREEN}GitHub Actions configured${NC}"
    echo "📋 Workflow files: $WORKFLOW_COUNT"
    
    if [ -f ".github/workflows/deploy-unified.yml" ]; then
        echo -e "✅ ${GREEN}Unified deployment workflow present${NC}"
    fi
else
    echo -e "❌ ${RED}No GitHub Actions workflows${NC}"
    echo "🔧 Consider setting up CI/CD pipeline"
fi
echo ""

# Project Structure
echo -e "${BLUE}📁 PROJECT STRUCTURE${NC}"
echo "===================="

CORE_DIRS=("src" "public" "docs" "tools")
for dir in "${CORE_DIRS[@]}"; do
    if [ -d "$dir" ]; then
        FILE_COUNT=$(find "$dir" -type f 2>/dev/null | wc -l)
        echo -e "✅ ${GREEN}$dir/ ($FILE_COUNT files)${NC}"
    else
        echo -e "⚠️ ${YELLOW}$dir/ missing${NC}"
    fi
done

# Check systematic operations
if [ -f "snakkaz" ] && [ -x "snakkaz" ]; then
    echo -e "✅ ${GREEN}Systematic operations script (./snakkaz)${NC}"
else
    echo -e "❌ ${RED}Systematic operations script missing${NC}"
fi
echo ""

# Quick Actions
echo -e "${BLUE}⚡ QUICK ACTIONS${NC}"
echo "================"
echo "🔄 Sync changes:     ./snakkaz sync"
echo "🚀 Start dev server: ./snakkaz dev"
echo "🏗️  Build project:    ./snakkaz build"
echo "📊 Full status:      ./snakkaz status"
echo "🆘 Emergency deploy: ./snakkaz emergency"
echo ""

# Summary
echo -e "${BLUE}📋 HEALTH SUMMARY${NC}"
echo "=================="

HEALTH_SCORE=0
MAX_SCORE=10

# Site online
if [ "$HTTP_STATUS" = "200" ]; then
    HEALTH_SCORE=$((HEALTH_SCORE + 3))
fi

# Git clean
if [ -z "$(git status --porcelain 2>/dev/null)" ]; then
    HEALTH_SCORE=$((HEALTH_SCORE + 1))
fi

# Build exists
if [ -d "dist" ]; then
    HEALTH_SCORE=$((HEALTH_SCORE + 2))
fi

# Dependencies OK
if [ -d "node_modules" ]; then
    HEALTH_SCORE=$((HEALTH_SCORE + 1))
fi

# Workflows exist
if [ -d ".github/workflows" ]; then
    HEALTH_SCORE=$((HEALTH_SCORE + 1))
fi

# Systematic operations
if [ -f "snakkaz" ] && [ -x "snakkaz" ]; then
    HEALTH_SCORE=$((HEALTH_SCORE + 2))
fi

echo "🎯 Overall Health: $HEALTH_SCORE/$MAX_SCORE"

if [ "$HEALTH_SCORE" -ge 8 ]; then
    echo -e "✅ ${GREEN}EXCELLENT - Project is healthy${NC}"
elif [ "$HEALTH_SCORE" -ge 6 ]; then
    echo -e "⚠️ ${YELLOW}GOOD - Minor issues to address${NC}"
else
    echo -e "❌ ${RED}NEEDS ATTENTION - Several issues detected${NC}"
fi

echo ""
echo "🔗 Resources:"
echo "   • Live Site: https://www.snakkaz.com"
echo "   • Repository: https://github.com/VatoAI/snakkaz-chat"
echo "   • Actions: https://github.com/VatoAI/snakkaz-chat/actions"
echo ""
echo "Generated by SnakkaZ Health Dashboard v2.0"
