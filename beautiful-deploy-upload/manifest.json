{
  "name": "SnakkaZ Beta - Sikker Chat",
  "short_name": "SnakkaZ",
  "description": "Fremtidens chat-plattform med end-to-end kryptering og AI-assistanse",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#1A1B23",
  "theme_color": "#D4AF37",
  "orientation": "portrait-primary",
  "dir": "ltr",
  "lang": "nb-NO",
  "scope": "/",
  "id": "app.snakkaz.beta",
  "categories": ["social", "communication", "productivity"],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Ny chat",
      "short_name": "Chat",
      "description": "Start ny samtale",
      "url": "/beta-chat?action=new",
      "icons": [{"src": "/icons/shortcut-chat.png", "sizes": "96x96"}]
    },
    {
      "name": "Inviter venner", 
      "short_name": "Inviter",
      "description": "Del SnakkaZ med venner",
      "url": "/invite",
      "icons": [{"src": "/icons/shortcut-invite.png", "sizes": "96x96"}]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+snakkaz",
      "url": "/handle-protocol?url=%s"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/chat-screen.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "SnakkaZ Chat Interface"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ]
}
