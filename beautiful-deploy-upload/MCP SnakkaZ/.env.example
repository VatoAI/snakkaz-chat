# Environment Configuration for SnakkaZ MCP Server

# SnakkaZ API Configuration
SNAKKAZ_API_URL=https://www.snakkaz.com/api
SNAKKAZ_API_KEY=your_api_key_here

# Supabase Configuration (if needed)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Security
MCP_SECRET_KEY=your_secret_key_here
