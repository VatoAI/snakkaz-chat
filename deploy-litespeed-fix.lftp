set ftp:ssl-allow false
set ftp:ssl-protect-data false
set ssl:verify-certificate false
set ftp:use-feat false
set ftp:use-mlsd false
set ftp:passive-mode true
set cmd:trace true

open ftp://snakkaz_admin:GR33nT3ch2024!@snakkaz.com

# Backup current .htaccess
get .htaccess .htaccess.backup.litespeed.$(date +%Y%m%d_%H%M%S) || echo "No existing .htaccess found"

# Upload LiteSpeed-optimized .htaccess
put dist/.htaccess .htaccess
echo "✅ LiteSpeed-optimized .htaccess uploaded"

# Verify the upload
ls -la .htaccess

# Test by getting first few lines
quote TYPE A
get .htaccess .htaccess.verify
!head -10 .htaccess.verify
!rm .htaccess.verify

quit
