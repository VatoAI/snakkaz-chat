}

# Function for git sync
git_sync() {
    echo "🔄 SYNCING WITH REPOSITORY..."
    echo ""
    echo "📊 Current status:"
    git status
    echo ""
    echo "⬇️ Pulling latest changes..."
    git pull origin main
    echo ""
    echo "⬆️ Pushing local changes..."
    git add .
    if [ -n "$(git diff --staged)" ]; then
        echo "📝 Enter commit message (or press Enter for auto-message):"
        read -r commit_msg
        if [ -z "$commit_msg" ]; then
            commit_msg="🔄 Daily sync - $(date '+%Y-%m-%d %H:%M')"
        fi
        git commit -m "$commit_msg"
        git push origin main
        echo "✅ Changes committed and pushed"
    else
        echo "✅ No changes to commit"
    fi
}

# Function for development start
start_dev() {
    echo "🚀 STARTING DEVELOPMENT ENVIRONMENT..."
    echo ""
    echo "📦 Installing dependencies..."
    npm install --legacy-peer-deps
    echo ""
    echo "🔥 Starting development server..."
    echo "🌐 Will open at http://localhost:5173"
    npm run dev
}

# Function for production build
build_prod() {
    echo "📦 BUILDING FOR PRODUCTION..."
    echo ""
    echo "🧹 Cleaning previous build..."
    npm run clean 2>/dev/null || rm -rf dist
    echo ""
    echo "🔍 Running linter..."
    npm run lint
    echo ""
    echo "🏗️ Building application..."
    npm run build
    echo ""
    if [ -f "dist/index.html" ]; then
        echo "✅ Build successful!"
        echo "📊 Bundle analysis:"
        ls -la dist/assets/ | head -10
        echo "... (showing first 10 files)"
        TOTAL_SIZE=$(du -sh dist | cut -f1)
        echo "📊 Total build size: $TOTAL_SIZE"
    else
        echo "❌ Build failed!"
        exit 1
    fi
}

# Function for deployment
deploy_app() {
    echo "🚀 DEPLOYING TO PRODUCTION..."
    echo ""
    
    # Check if automated deployment script exists
    if [ -f "./scripts/deploy-automated.sh" ]; then
        echo "📡 Using automated deployment script..."
        ./scripts/deploy-automated.sh
    else
        echo "📦 Building application..."
        build_prod
        echo ""
        echo "⬆️ Committing and pushing..."
        git add .
        git commit -m "🚀 Production deployment - $(date '+%Y-%m-%d %H:%M')"
        git push origin main
        echo ""
        echo "⏳ GitHub Actions will deploy automatically"
        echo "🔍 Monitor at: https://github.com/VatoAI/snakkaz-chat/actions"
        echo ""
        echo "✅ Deployment initiated!"
    fi
}

# Function to check status
check_status() {
    echo "📊 SNAKKAZ STATUS CHECK"
    echo "======================"
    echo ""
    echo "🌐 Testing live site..."
    if curl -s --head https://www.snakkaz.com | head -n 1 | grep -q "200 OK"; then
        echo -e "${GREEN}✅ Site is online - https://www.snakkaz.com${NC}"
    else
        echo -e "${RED}❌ Site appears to be down${NC}"
    fi
    echo ""
    echo "📝 Recent commits:"
    git log --oneline -5
    echo ""
    echo "📊 Current git status:"
    git status
}

# Function for deployment status check
check_deployment_status() {
    echo -e "${BLUE}${BOLD}⏳ Running enhanced deployment status check...${NC}"
    
    # Check if the enhanced script exists
    if [ -f "./scripts/deployment-status-check.sh" ]; then
        ./scripts/deployment-status-check.sh
    else
        echo -e "${RED}❌ Enhanced deployment status check script not found!${NC}"
        echo -e "${YELLOW}ℹ️ Running basic check instead...${NC}"
        check_status
    fi
}

# Function for memory system check
check_memory_system() {
    echo -e "${BLUE}${BOLD}🧠 MEMORY SYSTEM STATUS CHECK${NC}"
    echo -e "${BLUE}========================================${NC}"
    
    if [ -f "./scripts/monitor-memory-system.sh" ]; then
        ./scripts/monitor-memory-system.sh
    elif [ -f "./scripts/verify-memory-system.sh" ]; then
        ./scripts/verify-memory-system.sh
    else
        echo -e "${YELLOW}⚠️ Memory system monitoring script not found${NC}"
        echo -e "Checking basic files instead..."
        
        echo -e "\n${BLUE}Checking memory system files:${NC}"
        if [ -f "./src/pages/MemoryDashboard.tsx" ]; then
            echo -e "${GREEN}✓ Memory Dashboard found${NC}"
        else
            echo -e "${RED}✗ Memory Dashboard not found${NC}"
        fi
        
        if [ -f "./src/services/ai/memoryService.ts" ]; then
            echo -e "${GREEN}✓ Memory Service found${NC}"
        else
            echo -e "${RED}✗ Memory Service not found${NC}"
        fi
        
        if [ -f "./src/services/mcp/memoryServer.py" ]; then
            echo -e "${GREEN}✓ MCP Server found${NC}"
        else
            echo -e "${RED}✗ MCP Server not found${NC}"
        fi
    fi
}

# Function for emergency deployment
emergency_deploy() {
    echo -e "${RED}${BOLD}🚨 EMERGENCY DEPLOYMENT INITIATED${NC}"
    echo -e "${RED}================================${NC}"
    echo ""
    
    # Check for the newest emergency script first
    if [ -f "./scripts/emergency-deploy.sh" ]; then
        ./scripts/emergency-deploy.sh
    elif [ -f "./scripts/EMERGENCY-DEPLOY-CORRECTED-FTP.sh" ]; then
        ./scripts/EMERGENCY-DEPLOY-CORRECTED-FTP.sh
    elif [ -f "./emergency-deploy.lftp" ]; then
        echo -e "${YELLOW}Found LFTP script, running...${NC}"
        lftp -f ./emergency-deploy.lftp
    else
        echo -e "${YELLOW}⚠️ Emergency script not found, using direct deployment...${NC}"
        echo -e "${RED}This is a last resort method${NC}"
        build_prod
        
        # Create ZIP file
        echo -e "\n📦 Creating ZIP file..."
        zip -r snakkaz-dist.zip dist
        
        echo -e "\n🚨 MANUAL STEPS REQUIRED:"
        echo -e "1. Upload snakkaz-dist.zip to server via cPanel"
        echo -e "2. Extract ZIP in public_html directory"
        echo -e "\nSee detailed steps in the enhanced deployment status check"
        ./scripts/deployment-status-check.sh
    fi
}

# Main script logic
case "${1:-help}" in
    "sync")
        git_sync
        ;;
    "dev")
        start_dev
        ;;
    "build")
        build_prod
        ;;
    "deploy")
        deploy_app
        ;;
    "status")
        check_status
        ;;
    "check")
        check_deployment_status
        ;;
    "lint")
        echo "🔍 Running code quality checks..."
        npm run lint
        ;;
    "clean")
        echo "🧹 Cleaning build artifacts..."
        rm -rf dist node_modules/.cache
        echo "✅ Clean complete"
        ;;
    "install")
        echo "📦 Installing/updating dependencies..."
        npm install --legacy-peer_deps
        ;;
    "memory")
        check_memory_system
        ;;
    "emergency")
        emergency_deploy
        ;;
    "fix")
        echo "🔧 Quick fix deployment..."
        git add .
        git commit -m "🔧 Quick fix - $(date '+%Y-%m-%d %H:%M')"
        git push origin main
        ;;
    "monitor")
        echo "📊 Monitoring live site..."
        if [ -f "./scripts/monitor-memory-system.sh" ]; then
            ./scripts/monitor-memory-system.sh
        elif [ -f "./enhanced-health-monitor.sh" ]; then
            ./enhanced-health-monitor.sh
        else
            echo -e "${YELLOW}Monitor script not found${NC}"
            echo -e "Running deployment status check instead..."
            check_deployment_status
        fi
        ;;
    "docs")
        echo "📚 Opening documentation..."
        echo "📋 Main overview: SNAKKAZ-99-PERCENT-COMPLETE-OVERVIEW-AND-RESTRUCTURING.md"
        echo "📋 Architecture: docs/architecture/SNAKKAZ-MASTER-PROMPT.md"
        echo "📋 Current status: docs/current-status/"
        ;;
    "cleanup")
        echo "🧹 Cleaning up old deployment files..."
        if [ -f "./cleanup-cpanel.sh" ]; then
            ./cleanup-cpanel.sh
        else
            echo "❌ cleanup-cpanel.sh not found"
        fi
        ;;
    "extract")
        echo "📦 Extracting deployment ZIP..."
        if [ -f "./extract-cpanel.sh" ]; then
            ./extract-cpanel.sh
        else
            echo "❌ extract-cpanel.sh not found"
        fi
        ;;
    "logs")
        echo "📝 Recent commit history:"
        git log --oneline -10
        ;;
    "help"|*)
        show_operations
        ;;
esac
