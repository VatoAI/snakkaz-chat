#!/bin/bash

# 🎯 SNAKKAZ PROJECT HEALTH DASHBOARD
# Comprehensive system monitoring and status reporting

echo "🚀 SNAKKAZ PROJECT HEALTH DASHBOARD"
echo "===================================="
echo ""
echo "🕐 Generated: $(date)"
echo "🏠 Directory: $(pwd)"
echo ""

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Live Site Health
echo -e "${BLUE}🌐 LIVE SITE STATUS${NC}"
echo "==================="
HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" https://www.snakkaz.com 2>/dev/null || echo "FAIL")
if [ "$HTTP_STATUS" = "200" ]; then
    echo -e "✅ ${GREEN}www.snakkaz.com - ONLINE (HTTP 200)${NC}"
    
    # Check current bundle
    CURRENT_BUNDLE=$(curl -s https://www.snakkaz.com 2>/dev/null | grep -o 'index-[^.]*\.js' | head -1)
    if [ -n "$CURRENT_BUNDLE" ]; then
        echo "📦 Current bundle: $CURRENT_BUNDLE"
    fi
    
    # Check for Norwegian content
    if curl -s https://www.snakkaz.com | grep -q "SnakkaZ"; then
        echo "🇳🇴 Norwegian branding: Present"
    fi
    
    # Get response time
    RESPONSE_TIME=$(curl -w "%{time_total}" -s -o /dev/null https://www.snakkaz.com 2>/dev/null || echo "N/A")
    echo "⚡ Response time: ${RESPONSE_TIME}s"
    
else
    echo -e "❌ ${RED}www.snakkaz.com - OFFLINE or ERROR (HTTP $HTTP_STATUS)${NC}"
    echo "🔧 Recommended action: Run emergency deployment"
fi
echo ""

# Git Repository Health
echo -e "${BLUE}📝 GIT REPOSITORY STATUS${NC}"
echo "========================"
CURRENT_BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
echo "📍 Current branch: $CURRENT_BRANCH"

if [ "$CURRENT_BRANCH" = "main" ]; then
    echo -e "✅ ${GREEN}On main branch${NC}"
else
    echo -e "⚠️ ${YELLOW}Not on main branch${NC}"
fi

# Check git status
UNCOMMITTED=$(git status --porcelain 2>/dev/null | wc -l)
if [ "$UNCOMMITTED" -eq 0 ]; then
    echo -e "✅ ${GREEN}Working directory clean${NC}"
else
    echo -e "📝 ${YELLOW}Uncommitted changes: $UNCOMMITTED files${NC}"
    git status --porcelain | head -10
    if [ "$UNCOMMITTED" -gt 10 ]; then
        echo "... and $((UNCOMMITTED - 10)) more files"
    fi
fi

# Check sync status
git fetch origin main --quiet 2>/dev/null
AHEAD=$(git rev-list --count origin/main..HEAD 2>/dev/null || echo "0")
BEHIND=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo "0")

if [ "$AHEAD" -eq 0 ] && [ "$BEHIND" -eq 0 ]; then
    echo -e "✅ ${GREEN}In sync with origin/main${NC}"
elif [ "$AHEAD" -gt 0 ]; then
    echo -e "⬆️ ${YELLOW}Ahead: $AHEAD commits${NC}"
elif [ "$BEHIND" -gt 0 ]; then
    echo -e "⬇️ ${YELLOW}Behind: $BEHIND commits${NC}"
fi

echo ""
echo "📋 Recent commits:"
git log --oneline -3 2>/dev/null | head -3 | sed 's/^/=/g' || echo "No git history"
echo ""

# Build Health
echo -e "${BLUE}📦 BUILD STATUS${NC}"
echo "==============="
if [ -d "dist" ]; then
    BUILD_TIME=$(stat -c %y dist 2>/dev/null | cut -d'.' -f1 || echo "unknown")
    echo -e "✅ ${GREEN}dist/ directory exists${NC}"
    
    if [ -f "dist/index.html" ]; then
        echo -e "✅ ${GREEN}index.html present${NC}"
    fi
    
    # Count JS bundles
    JS_COUNT=$(find dist -name "*.js" -type f 2>/dev/null | wc -l)
    echo "📊 JavaScript bundles: $JS_COUNT files"
    
    if [ "$JS_COUNT" -lt 30 ]; then
        echo -e "✅ ${GREEN}Optimized bundle count${NC}"
    elif [ "$JS_COUNT" -lt 100 ]; then
        echo -e "📊 ${YELLOW}Moderate bundle count (acceptable)${NC}"
    else
        echo -e "⚠️ ${YELLOW}High bundle count (consider optimization)${NC}"
    fi
    
    # Check main bundles
    MAIN_BUNDLE=$(find dist -name "index-*.js" 2>/dev/null | head -1 | xargs basename 2>/dev/null || echo "not found")
    VENDOR_BUNDLE=$(find dist -name "vendor-misc-*.js" 2>/dev/null | head -1 | xargs basename 2>/dev/null || echo "not found")
    echo "📦 Main bundle: $MAIN_BUNDLE"
    echo "📦 Vendor bundle: $VENDOR_BUNDLE"
    
    # Build age
    if [ -n "$BUILD_TIME" ] && [ "$BUILD_TIME" != "unknown" ]; then
        echo "🕐 Build time: $BUILD_TIME"
    fi
    
else
    echo -e "❌ ${RED}No build found${NC}"
    echo "🔧 Run: ./snakkaz build"
fi
echo ""

# Dependencies Health
echo -e "${BLUE}📚 DEPENDENCIES STATUS${NC}"
echo "======================"
if [ -d "node_modules" ]; then
    echo -e "✅ ${GREEN}node_modules/ present${NC}"
    
    # Check package-lock age
    if [ -f "package-lock.json" ]; then
        LOCK_AGE=$(find package-lock.json -mtime +7 2>/dev/null || echo "")
        if [ -z "$LOCK_AGE" ]; then
            echo -e "🔒 ${GREEN}Dependencies recently updated (< 7 days)${NC}"
        else
            echo -e "⚠️ ${YELLOW}Dependencies may need updating (> 7 days)${NC}"
        fi
    fi
    
    # Security check
    echo "🔍 Checking for security vulnerabilities..."
    if command -v npm &> /dev/null; then
        AUDIT_RESULT=$(npm audit --audit-level=high --silent 2>/dev/null | grep -c "vulnerabilities" || echo "0")
        if [ "$AUDIT_RESULT" -eq 0 ]; then
            echo -e "🔒 ${GREEN}No high-severity vulnerabilities${NC}"
        else
            echo -e "⚠️ ${YELLOW}Security vulnerabilities found${NC}"
            echo "🔧 Run: npm audit fix"
        fi
    fi
else
    echo -e "❌ ${RED}node_modules/ missing${NC}"
    echo "🔧 Run: ./snakkaz install"
fi
echo ""

# GitHub Actions Status
echo -e "${BLUE}🔄 GITHUB ACTIONS STATUS${NC}"
echo "========================="
WORKFLOW_COUNT=$(find .github/workflows -name "*.yml" -o -name "*.yaml" 2>/dev/null | wc -l)
echo "📋 Workflow files: $WORKFLOW_COUNT"

if [ "$WORKFLOW_COUNT" -gt 0 ]; then
    echo "📄 Available workflows:"
    find .github/workflows -name "*.yml" -o -name "*.yaml" 2>/dev/null | while read -r workflow; do
        WORKFLOW_NAME=$(basename "$workflow" .yml | sed 's/.yaml$//')
        echo "  - $WORKFLOW_NAME"
    done
fi

if [ -f ".github/workflows/deploy-unified.yml" ]; then
    echo -e "✅ ${GREEN}Unified deployment workflow present${NC}"
fi

echo ""
echo "🔗 GitHub Actions: https://github.com/VatoAI/snakkaz-chat/actions"
echo ""

# Project Structure
echo -e "${BLUE}📁 PROJECT STRUCTURE${NC}"
echo "===================="
for dir in src dist public .github docs scripts; do
    if [ -d "$dir" ]; then
        FILE_COUNT=$(find "$dir" -type f 2>/dev/null | wc -l)
        echo -e "✅ ${GREEN}$dir/ ($FILE_COUNT files)${NC}"
    else
        echo -e "❌ ${RED}$dir/ missing${NC}"
    fi
done

# Check key files
if [ -f "snakkaz" ]; then
    echo -e "✅ ${GREEN}Systematic operations script (./snakkaz)${NC}"
fi

if [ -f "README.md" ]; then
    README_LINES=$(wc -l < README.md 2>/dev/null || echo "0")
    echo -e "✅ ${GREEN}Comprehensive README.md ($README_LINES lines)${NC}"
fi
echo ""

# Recommendations
echo -e "${BLUE}💡 RECOMMENDATIONS${NC}"
echo "=================="

# Determine overall health
ISSUES=0

if [ "$HTTP_STATUS" != "200" ]; then
    echo -e "🔴 ${RED}Priority: Check site deployment (./snakkaz status)${NC}"
    ((ISSUES++))
fi

if [ "$UNCOMMITTED" -gt 0 ]; then
    echo -e "🟡 ${YELLOW}Consider: Commit pending changes (./snakkaz sync)${NC}"
fi

if [ ! -d "dist" ]; then
    echo -e "🟡 ${YELLOW}Consider: Build production version (./snakkaz build)${NC}"
    ((ISSUES++))
fi

if [ "$JS_COUNT" -gt 100 ]; then
    echo -e "🟡 ${YELLOW}Optimize: Consider bundle optimization ($JS_COUNT JS files)${NC}"
fi

if [ "$ISSUES" -eq 0 ]; then
    echo -e "🎉 ${GREEN}All systems optimal! No immediate actions needed.${NC}"
    echo ""
    echo -e "🚀 ${GREEN}Suggested next steps:${NC}"
    echo "  - Monitor site performance"
    echo "  - Engage Norwegian tech community"
    echo "  - Plan next feature development"
fi

echo ""

# Quick Actions
echo -e "${BLUE}⚡ QUICK ACTIONS${NC}"
echo "==============="
echo ""
echo "🔄 Daily operations:"
echo "  ./snakkaz sync     - Sync repository"
echo "  ./snakkaz dev      - Start development"
echo "  ./snakkaz build    - Create build"
echo "  ./snakkaz deploy   - Deploy to production"
echo "  ./snakkaz status   - Check deployment status"
echo ""
echo "🚨 Emergency operations:"
echo "  ./snakkaz emergency - Emergency deployment"
echo "  ./snakkaz fix      - Quick fix deployment"
echo "  ./snakkaz monitor  - Monitor live site"
echo ""
echo "📚 Documentation:"
echo "  ./snakkaz docs     - Open documentation"
echo "  ./snakkaz help     - Show all commands"
echo ""
echo "=================================="
echo "🎯 SnakkaZ Project Health Dashboard"
echo "🇳🇴 Norwegian Tech Community Ready"
echo "=================================="
