{
  "name": "SnakkaZ Chat - The Ultimate Chat App",
  "description": "A real-time chat application that dominates all competitors",
  "repository": "https://github.com/yourusername/snakkaz-chat",
  "logo": "https://snakkaz.com/logo.png",
  "keywords": ["node", "express", "websocket", "chat", "real-time"],
  "image": "heroku/nodejs",
  "stack": "heroku-20",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql:mini",
      "as": "DATABASE"
    },
    {
      "plan": "heroku-redis:mini",
      "as": "REDIS"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "NPM_CONFIG_PRODUCTION": "true"
  },
  "scripts": {
    "postdeploy": "node -e \"console.log('SnakkaZ Chat deployed successfully!')\""
  }
}
