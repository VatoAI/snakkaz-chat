#!/usr/bin/lftp -f

# Komplett emergency fix
set ssl:verify-certificate false
set ftp:ssl-force true
set ftp:ssl-protect-data true

# Connect
open -u snakkaz.com,B48@.m*VhQUF sftp://ftp.domeneshop.no

# Sørg for at mapper eksisterer
echo "📁 Creating directories..."
mkdir -p assets
mkdir -p assets/js
mkdir -p assets/css

# Upload index.html
echo "🔄 Uploading index.html..."
put dist/index.html index.html

# Upload ALL JavaScript files (bulk upload)
echo "🔄 Uploading ALL JavaScript files..."
lcd dist/assets/js
cd assets/js
mput *.js

# Upload CSS files
echo "🔄 Uploading CSS files..."
lcd ../../css
cd ../css
mput *.css

# Upload .htaccess
echo "🔄 Uploading .htaccess..."
lcd ../../../
cd /
put .htaccess .htaccess

# Set permissions
echo "🔧 Setting permissions..."
chmod 644 index.html
chmod 644 .htaccess
chmod -R 644 assets/

echo "✅ Complete deployment finished"
quit
