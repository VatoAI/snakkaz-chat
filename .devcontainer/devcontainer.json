{
  "name": "Snakkaz Chat Development",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:18",
  "workspaceFolder": "/workspaces/snakkaz-chat",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/snakkaz-chat,type=bind,consistency=cached",
  "forwardPorts": [3000, 5173],
  "postCreateCommand": "npm install",
  "containerEnv": {
    "VITE_AI_ENABLED": "true",
    "VITE_AI_DEFAULT_PROVIDER": "anthropic",
    "VITE_AI_DEFAULT_MODEL": "claude-3-5-sonnet-20241022",
    "VITE_AI_MAX_TOKENS": "4000",
    "VITE_AI_TEMPERATURE": "0.7",
    "VITE_DEBUG_MODE": "true"
  },
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.cwd": "/workspaces/snakkaz-chat"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint", 
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "files.exclude": {
          "node_modules": true
        },
        "workbench.startupEditor": "none",
        "workbench.colorTheme": "Default Dark Modern",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": true
        },
        "github.copilot.enable": {
          "*": true,
          "yaml": true,
          "plaintext": true,
          "markdown": true,
          "javascript": true,
          "typescript": true,
          "jsx": true,
          "tsx": true
        }
      }
    }
  }
}
