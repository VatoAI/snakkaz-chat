#!/usr/bin/env lftp -f

# Emergency FTP upload for Snakkaz Chat - KORREKTE DETALJER
# Connection details from user
open ftp://ftp.snakkaz.com:21
user snakqsqe

# Clear existing files and upload fresh
cd /public_html
rm -rf *

# Upload everything from dist directory
lcd /workspaces/snakkaz-chat/dist
mirror -R . /public_html/

# Upload emergency fix
lcd /workspaces/snakkaz-chat/public
put emergency-react-fix.js /public_html/emergency-react-fix.js

# Close connection
close
quit
