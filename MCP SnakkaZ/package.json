{
  "name": "snakkaz-mcp-server",
  "version": "2.1.0",
  "description": "Advanced Model Context Protocol server for Norwegian tech community with SnakkaZ Chat integration",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "snakkaz-mcp": "./build/index.js"
  },
  "scripts": {
    "start": "node build/simple-server.js",
    "start:http": "node build/server.js",
    "start:demo": "node build/demo-infrastructure.js",
    "dev": "tsx src/simple-server.ts",
    "dev:http": "tsc && node build/server.js",
    "build": "tsc",
    "build:prod": "tsc --build --clean && tsc",
    "build:watch": "tsc --watch",
    "test": "npm run test:unit && npm run test:integration && npm run test:final",
    "test:unit": "node tests/basic.test.js",
    "test:integration": "node tests/websearch.test.js",
    "test:mcp": "node build/index.js --test",
    "test:final": "node scripts/final-deployment-test.mjs",
    "test:live": "node scripts/test-mcp-live.js",
    "help": "node build/index.js --help",
    "info": "node build/index.js --info",
    "version": "node build/index.js --version",
    "lint": "tsc --noEmit",
    "lint:fix": "tsc --noEmit && prettier --write src/**/*.ts",
    "clean": "rimraf build && rimraf node_modules/.cache",
    "deploy": "npm run build:prod && npm run test",
    "deploy:ready": "npm run build:prod && npm run test:final",
    "security:scan": "npm audit --audit-level moderate"
  },
  "keywords": [
    "snakkaz",
    "mcp",
    "model-context-protocol",
    "chat",
    "ai",
    "norwegian-tech",
    "e2ee",
    "encrypted-chat"
  ],
  "author": "SnakkaZ Team",
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.9",
    "concurrently": "^9.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.1",
    "@supabase/supabase-js": "^2.50.4",
    "axios": "^1.10.0",
    "cheerio": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "node-fetch": "^3.3.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.74",
    "zod-to-json-schema": "^3.24.6"
  }
}
