set ssl:verify-certificate no
set ftp:passive-mode on
open -u admin@snakkaz.com,Rompetroll123! ftp://ftp.snakkaz.com

# Check current index.html in root
ls -la index.html

# Show file size details
quote SIZE index.html

# Delete the old index.html from root
rm index.html

# Upload new index.html to root
lcd dist
put index.html

# Verify the upload
ls -la index.html
quote SIZE index.html

# Also put in public_html for safety
cd public_html
rm index.html
put index.html
ls -la index.html

# Final verification
cd /
ls -la index.html

quit
