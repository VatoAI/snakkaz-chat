#!/usr/bin/lftp -f
set ftp:ssl-allow no
set ftp:ssl-force no
set ftp:passive-mode on
set net:timeout 10
set net:max-retries 3

open ftp://admin%40snakkaz.com:Rompetroll123!@ftp.snakkaz.com

# Create MCP admin directory structure
mkdir -p public_html/mcp
mkdir -p public_html/mcp/admin
mkdir -p public_html/mcp/api
mkdir -p public_html/mcp/assets

# Upload dashboard files
lcd dist/mcp-admin
cd public_html/mcp

put index.html
put login.html
put config.js
put .htaccess

# Create API placeholder
cd api
put -c <<EOF
{
  "status": "MCP API v2.0",
  "message": "API endpoints will be implemented here",
  "endpoints": {
    "auth": "/api/auth",
    "users": "/api/users",
    "chats": "/api/chats",
    "email": "/api/email",
    "metrics": "/api/metrics"
  }
}
