#!/bin/bash

# 🎯 SNAKKAZ PROJECT HEALTH DASHBOARD
# Comprehensive system monitoring and status reporting

echo "🚀 SNAKKAZ PROJECT HEALTH DASHBOARD"
echo "===================================="
echo ""

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to check live site status
check_live_site() {
    echo -e "${BLUE}🌐 LIVE SITE STATUS${NC}"
    echo "==================="
    
    # Test main site
    if curl -s --head https://www.snakkaz.com | head -n 1 | grep -q "200 OK"; then
        echo -e "✅ ${GREEN}www.snakkaz.com - ONLINE${NC}"
        
        # Get response time
        RESPONSE_TIME=$(curl -w "%{time_total}" -s -o /dev/null https://www.snakkaz.com)
        echo "⚡ Response time: ${RESPONSE_TIME}s"
        
        # Check for Norwegian content
        if curl -s https://www.snakkaz.com | grep -q "SnakkaZ"; then
            echo -e "🇳🇴 ${GREEN}Norwegian branding: Present${NC}"
        else
            echo -e "⚠️ ${YELLOW}Norwegian branding: Not detected${NC}"
        fi
        
        # Check for React errors
        if curl -s https://www.snakkaz.com | grep -q "Nt is undefined"; then
            echo -e "❌ ${RED}React errors detected${NC}"
        else
            echo -e "✅ ${GREEN}No React errors detected${NC}"
        fi
        
    else
        echo -e "❌ ${RED}www.snakkaz.com - OFFLINE or ERROR${NC}"
        echo "🔧 Recommended action: Run emergency deployment"
    fi
    echo ""
}

# Function to check git repository status
check_git_status() {
    echo -e "${BLUE}📝 GIT REPOSITORY STATUS${NC}"
    echo "========================"
    
    # Current branch
    CURRENT_BRANCH=$(git branch --show-current)
    echo "📍 Current branch: $CURRENT_BRANCH"
    
    # Check if on main
    if [ "$CURRENT_BRANCH" = "main" ]; then
        echo -e "✅ ${GREEN}On main branch${NC}"
    else
        echo -e "⚠️ ${YELLOW}Not on main branch${NC}"
    fi
    
    # Git status
    if [ -n "$(git status --porcelain)" ]; then
        echo -e "📝 ${YELLOW}Uncommitted changes:${NC}"
        git status --porcelain | head -5
        if [ $(git status --porcelain | wc -l) -gt 5 ]; then
            echo "... and $(( $(git status --porcelain | wc -l) - 5 )) more files"
        fi
    else
        echo -e "✅ ${GREEN}Working directory clean${NC}"
    fi
    
    # Check if ahead/behind
    git fetch origin main 2>/dev/null
    AHEAD=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo "0")
    BEHIND=$(git rev-list --count origin/main..HEAD 2>/dev/null || echo "0")
    
    if [ "$AHEAD" -gt 0 ]; then
        echo -e "⬇️ ${YELLOW}$AHEAD commits behind origin/main${NC}"
    fi
    
    if [ "$BEHIND" -gt 0 ]; then
        echo -e "⬆️ ${YELLOW}$BEHIND commits ahead of origin/main${NC}"
    fi
    
    if [ "$AHEAD" -eq 0 ] && [ "$BEHIND" -eq 0 ]; then
        echo -e "✅ ${GREEN}In sync with origin/main${NC}"
    fi
    
    # Recent commits
    echo ""
    echo "📋 Recent commits:"
    git log --oneline -3
    echo ""
}

# Function to check build status
check_build_status() {
    echo -e "${BLUE}📦 BUILD STATUS${NC}"
    echo "==============="
    
    # Check if dist directory exists
    if [ -d "dist" ]; then
        echo -e "✅ ${GREEN}dist/ directory exists${NC}"
        
        # Check index.html
        if [ -f "dist/index.html" ]; then
            echo -e "✅ ${GREEN}index.html present${NC}"
            
            # Check bundle count
            JS_COUNT=$(find dist/assets/js -name "*.js" 2>/dev/null | wc -l)
            echo "📊 JavaScript bundles: $JS_COUNT files"
            
            if [ "$JS_COUNT" -gt 100 ]; then
                echo -e "⚠️ ${YELLOW}High bundle count (optimization recommended)${NC}"
            elif [ "$JS_COUNT" -gt 50 ]; then
                echo -e "📊 ${BLUE}Moderate bundle count (acceptable)${NC}"
            else
                echo -e "✅ ${GREEN}Optimized bundle count${NC}"
            fi
            
            # Check main bundles
            if ls dist/assets/js/index-*.js >/dev/null 2>&1; then
                MAIN_BUNDLE=$(ls dist/assets/js/index-*.js | head -1 | xargs basename)
                echo "📦 Main bundle: $MAIN_BUNDLE"
            fi
            
            if ls dist/assets/js/vendor-misc-*.js >/dev/null 2>&1; then
                VENDOR_BUNDLE=$(ls dist/assets/js/vendor-misc-*.js | head -1 | xargs basename)
                echo "📦 Vendor bundle: $VENDOR_BUNDLE"
            fi
            
        else
            echo -e "❌ ${RED}index.html missing${NC}"
        fi
        
        # Check build timestamp
        BUILD_TIME=$(stat -c %Y dist/index.html 2>/dev/null || echo "0")
        CURRENT_TIME=$(date +%s)
        AGE_HOURS=$(( (CURRENT_TIME - BUILD_TIME) / 3600 ))
        
        if [ "$AGE_HOURS" -lt 1 ]; then
            echo -e "🕐 ${GREEN}Build age: ${AGE_HOURS}h (fresh)${NC}"
        elif [ "$AGE_HOURS" -lt 24 ]; then
            echo -e "🕐 ${YELLOW}Build age: ${AGE_HOURS}h (recent)${NC}"
        else
            echo -e "🕐 ${RED}Build age: ${AGE_HOURS}h (old)${NC}"
        fi
        
    else
        echo -e "❌ ${RED}dist/ directory missing${NC}"
        echo "🔧 Run: ./snakkaz build"
    fi
    echo ""
}

# Function to check dependencies
check_dependencies() {
    echo -e "${BLUE}📚 DEPENDENCIES STATUS${NC}"
    echo "======================"
    
    # Check if node_modules exists
    if [ -d "node_modules" ]; then
        echo -e "✅ ${GREEN}node_modules/ present${NC}"
        
        # Check package-lock.json age
        if [ -f "package-lock.json" ]; then
            LOCK_TIME=$(stat -c %Y package-lock.json 2>/dev/null || echo "0")
            CURRENT_TIME=$(date +%s)
            LOCK_AGE_DAYS=$(( (CURRENT_TIME - LOCK_TIME) / 86400 ))
            
            if [ "$LOCK_AGE_DAYS" -lt 7 ]; then
                echo -e "🔒 ${GREEN}Dependencies recently updated (${LOCK_AGE_DAYS} days ago)${NC}"
            elif [ "$LOCK_AGE_DAYS" -lt 30 ]; then
                echo -e "🔒 ${YELLOW}Dependencies updated ${LOCK_AGE_DAYS} days ago${NC}"
            else
                echo -e "🔒 ${RED}Dependencies old (${LOCK_AGE_DAYS} days ago)${NC}"
                echo "🔧 Consider running: npm update"
            fi
        fi
        
        # Check for security vulnerabilities
        if command -v npm >/dev/null 2>&1; then
            echo "🔍 Checking for security vulnerabilities..."
            AUDIT_RESULT=$(npm audit --audit-level=moderate 2>&1)
            if echo "$AUDIT_RESULT" | grep -q "0 vulnerabilities"; then
                echo -e "🛡️ ${GREEN}No known vulnerabilities${NC}"
            else
                echo -e "⚠️ ${YELLOW}Security vulnerabilities found${NC}"
                echo "🔧 Run: npm audit fix"
            fi
        fi
        
    else
        echo -e "❌ ${RED}node_modules/ missing${NC}"
        echo "🔧 Run: ./snakkaz install"
    fi
    echo ""
}

# Function to check GitHub Actions status
check_github_actions() {
    echo -e "${BLUE}🔄 GITHUB ACTIONS STATUS${NC}"
    echo "========================="
    
    # Check workflow files
    WORKFLOW_COUNT=$(find .github/workflows -name "*.yml" 2>/dev/null | wc -l)
    echo "📋 Workflow files: $WORKFLOW_COUNT"
    
    if [ "$WORKFLOW_COUNT" -gt 0 ]; then
        echo "📄 Available workflows:"
        find .github/workflows -name "*.yml" -exec basename {} .yml \; | sed 's/^/  - /'
        
        # Check for unified workflow
        if [ -f ".github/workflows/deploy-unified.yml" ]; then
            echo -e "✅ ${GREEN}Unified deployment workflow present${NC}"
        else
            echo -e "⚠️ ${YELLOW}Consider implementing unified workflow${NC}"
        fi
    else
        echo -e "❌ ${RED}No GitHub Actions workflows found${NC}"
    fi
    
    echo ""
    echo "🔗 GitHub Actions: https://github.com/VatoAI/snakkaz-chat/actions"
    echo ""
}

# Function to check project structure
check_project_structure() {
    echo -e "${BLUE}📁 PROJECT STRUCTURE${NC}"
    echo "===================="
    
    # Core directories
    CORE_DIRS=("src" "dist" "public" ".github" "docs" "scripts")
    
    for dir in "${CORE_DIRS[@]}"; do
        if [ -d "$dir" ]; then
            FILE_COUNT=$(find "$dir" -type f 2>/dev/null | wc -l)
            echo -e "✅ ${GREEN}$dir/ ($FILE_COUNT files)${NC}"
        else
            echo -e "❌ ${RED}$dir/ missing${NC}"
        fi
    done
    
    # Check for systematic operations script
    if [ -f "snakkaz" ] && [ -x "snakkaz" ]; then
        echo -e "✅ ${GREEN}Systematic operations script (./snakkaz)${NC}"
    else
        echo -e "⚠️ ${YELLOW}Systematic operations script missing${NC}"
    fi
    
    # Check for documentation
    if [ -f "README.md" ]; then
        README_SIZE=$(wc -l < README.md 2>/dev/null || echo "0")
        if [ "$README_SIZE" -gt 50 ]; then
            echo -e "✅ ${GREEN}Comprehensive README.md (${README_SIZE} lines)${NC}"
        else
            echo -e "⚠️ ${YELLOW}Basic README.md (${README_SIZE} lines)${NC}"
        fi
    else
        echo -e "❌ ${RED}README.md missing${NC}"
    fi
    
    echo ""
}

# Function to generate recommendations
generate_recommendations() {
    echo -e "${BLUE}💡 RECOMMENDATIONS${NC}"
    echo "=================="
    
    # Check various conditions and provide recommendations
    RECOMMENDATIONS=()
    
    # Git recommendations
    if [ -n "$(git status --porcelain)" ]; then
        RECOMMENDATIONS+=("🔄 Sync repository: ./snakkaz sync")
    fi
    
    # Build recommendations
    if [ ! -d "dist" ] || [ ! -f "dist/index.html" ]; then
        RECOMMENDATIONS+=("📦 Create fresh build: ./snakkaz build")
    fi
    
    # Dependencies recommendations
    if [ ! -d "node_modules" ]; then
        RECOMMENDATIONS+=("📚 Install dependencies: ./snakkaz install")
    fi
    
    # Bundle optimization
    if [ -d "dist/assets/js" ]; then
        JS_COUNT=$(find dist/assets/js -name "*.js" 2>/dev/null | wc -l)
        if [ "$JS_COUNT" -gt 100 ]; then
            RECOMMENDATIONS+=("⚡ Optimize bundles: Review vite.config.ts for code splitting")
        fi
    fi
    
    # Documentation recommendations
    if [ ! -f "SNAKKAZ-99-PERCENT-COMPLETE-OVERVIEW-AND-RESTRUCTURING.md" ]; then
        RECOMMENDATIONS+=("📋 Review comprehensive overview document")
    fi
    
    # Print recommendations
    if [ ${#RECOMMENDATIONS[@]} -eq 0 ]; then
        echo -e "🎉 ${GREEN}All systems optimal! No immediate actions needed.${NC}"
        echo ""
        echo "🚀 Suggested next steps:"
        echo "  - Monitor site performance"
        echo "  - Engage Norwegian tech community"
        echo "  - Plan next feature development"
    else
        echo "🎯 Immediate actions recommended:"
        for rec in "${RECOMMENDATIONS[@]}"; do
            echo "  $rec"
        done
    fi
    
    echo ""
}

# Function to show quick actions
show_quick_actions() {
    echo -e "${BLUE}⚡ QUICK ACTIONS${NC}"
    echo "==============="
    echo ""
    echo "🔄 Daily operations:"
    echo "  ./snakkaz sync     - Sync repository"
    echo "  ./snakkaz dev      - Start development"
    echo "  ./snakkaz build    - Create build"
    echo "  ./snakkaz deploy   - Deploy to production"
    echo "  ./snakkaz status   - Check deployment status"
    echo ""
    echo "🚨 Emergency operations:"
    echo "  ./snakkaz emergency - Emergency deployment"
    echo "  ./snakkaz fix      - Quick fix deployment"
    echo "  ./snakkaz monitor  - Monitor live site"
    echo ""
    echo "📚 Documentation:"
    echo "  ./snakkaz docs     - Open documentation"
    echo "  ./snakkaz help     - Show all commands"
    echo ""
}

# Main execution
main() {
    # Header with timestamp
    echo "🕐 Generated: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "🏠 Directory: $(pwd)"
    echo ""
    
    # Run all checks
    check_live_site
    check_git_status
    check_build_status
    check_dependencies
    check_github_actions
    check_project_structure
    generate_recommendations
    show_quick_actions
    
    # Footer
    echo "=================================="
    echo "🎯 SnakkaZ Project Health Dashboard"
    echo "🇳🇴 Norwegian Tech Community Ready"
    echo "=================================="
}

# Run the dashboard
main "$@"
