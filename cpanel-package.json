{
  "name": "snakkaz-mcp-production",
  "version": "3.0.0-complete",
  "description": "SnakkaZ MCP Complete Production Server - HTTP + Llama + Memory + All Tools",
  "main": "server-production-complete.cjs",
  "scripts": {
    "start": "node server-production-complete.cjs",
    "dev": "node --inspect server-production-complete.cjs",
    "test": "echo \"✅ SnakkaZ MCP Server Test\" && node server-production-complete.cjs",
    "health": "curl -s https://mcp.snakkaz.com/health || echo \"Server not responding\"",
    "restart": "pkill -f server-production-complete.cjs && node server-production-complete.cjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol", 
    "snakkaz",
    "chat",
    "e2ee",
    "llama",
    "memory",
    "ai",
    "production"
  ],
  "author": "SnakkaZ Team <team@snakkaz.com>",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VatoAI/snakkaz-chat"
  },
  "mcp": {
    "display_name": "SnakkaZ Complete MCP Server",
    "description": "Production MCP server with HTTP endpoints, Llama AI, memory persistence, and all SnakkaZ tools",
    "version": "3.0.0-complete",
    "capabilities": {
      "http_server": true,
      "llama_integration": true,
      "memory_persistence": true,
      "tools_count": 12,
      "health_monitoring": true,
      "cpanel_ready": true
    },
    "endpoints": {
      "health": "/health",
      "tools": "/api/tools",
      "memory": "/api/memory",
      "llama": "/api/llama/chat",
      "dashboard": "/",
      "knowledge": "/api/knowledge"
    }
  }
}
