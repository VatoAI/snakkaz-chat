# Example environment variables for Namecheap API
# Copy this file to .env and fill in your actual values

# ========= DEPLOYMENT CONFIGURATION =========
# FTP Deployment Settings
FTP_HOST=ftp.snakkaz.com
FTP_USER=admin@snakkaz.com
FTP_PASSWORD=Rompetroll123!
FTP_PORT=21
FTP_PATH=/public_html

# cPanel API Settings (for automated extraction)
CPANEL_API_URL=https://snakkaz.com:2083
CPANEL_API_TOKEN=your_cpanel_api_token
CPANEL_USERNAME=admin@snakkaz.com

# Namecheap API credentials
NAMECHEAP_API_USER=YourApiUser
NAMECHEAP_API_KEY=YourApiKey
NAMECHEAP_USERNAME=YourUsername

# ========= AI SERVER CONFIGURATION =========
# AI Server Configuration (Remote VPS)
# Sett denne til din AI server URL etter VPS setup
VITE_AI_SERVER_URL=https://ai.snakkaz.com

# Alternative for testing (local development)
# VITE_AI_SERVER_URL=http://localhost:3001
NAMECHEAP_CLIENT_IP=YourClientIp

# Supabase project settings
SUPABASE_PROJECT_REF=project-wqpoozpbceucynsojmbk
VITE_SUPABASE_URL=https://wqpoozpbceucynsojmbk.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Service Configuration
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
AZURE_OPENAI_ENDPOINT=https://your-azure-endpoint
AZURE_OPENAI_KEY=your-azure-key-here

# AI Model Configuration
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# AI Feature Flags
AI_ENABLED=true
AI_ANTHROPIC_ENABLED=true
AI_OPENAI_ENABLED=true
AI_AZURE_ENABLED=false

# Rate Limiting & Cost Management
AI_RATE_LIMIT_PER_USER=100
AI_RATE_LIMIT_WINDOW=3600
AI_DAILY_COST_LIMIT_NOK=500
AI_USER_MONTHLY_TOKEN_LIMIT=50000
