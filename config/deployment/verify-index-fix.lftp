set ssl:verify-certificate no
set ftp:passive-mode on
set cmd:fail-exit yes

# Connect to FTP
open -u admin@snakkaz.com,Rompetroll123! ftp://ftp.snakkaz.com

# Check current index.html on server
echo "=== CURRENT index.html ON SERVER ==="
cat index.html | head -20
echo ""
echo "=== END OF SERVER index.html ==="

# Backup current index.html
get index.html index-backup-$(date +%H%M).html
echo "✅ Backed up current index.html"

# Force upload new index.html
put dist/index.html index.html
echo "✅ NEW index.html uploaded"

# Verify upload
echo "=== VERIFYING NEW index.html ==="
cat index.html | grep -A5 -B5 "modulepreload\|index-.*\.js"

quit
